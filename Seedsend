<!DOCTYPE html>
<html>
<head>
  <title>SeedSend - Crypto Wallet</title>
  <script src="https://cdn.jsdelivr.net/npm/bip39"></script>
  <script src="https://cdn.jsdelivr.net/npm/bip32"></script>
  <script src="https://cdn.jsdelivr.net/npm/bitcoinjs-lib"></script>
  <script src="https://cdn.jsdelivr.net/npm/ethers/dist/ethers.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/tronweb/dist/TronWeb.js"></script>
</head>
<body>
  <h1>SeedSend</h1>
  <textarea id="seed" placeholder="Enter your 12/24-word seed phrase" rows="4" cols="50"></textarea><br>
  <button onclick="restoreWallet()">Restore Wallet</button>
  <div id="results"></div>

  <script>
    async function restoreWallet() {
      const seedPhrase = document.getElementById('seed').value.trim();
      if (!bip39.validateMnemonic(seedPhrase)) {
        alert("Invalid seed phrase");
        return;
      }

      const seed = await bip39.mnemonicToSeed(seedPhrase);
      const root = bitcoinjs.bip32.fromSeed(seed);

      // --- BTC Example (first address) ---
      const btcPath = "m/44'/0'/0'/0/0";
      const child = root.derivePath(btcPath);
      const { address } = bitcoinjs.payments.p2pkh({ pubkey: child.publicKey });

      // --- ETH Example (first address) ---
      const ethWallet = ethers.Wallet.fromMnemonic(seedPhrase);
      const ethAddress = ethWallet.address;

      // --- TRON Example (first address) ---
      const tronWeb = new TronWeb({
        fullHost: 'https://api.trongrid.io'
      });
      const tronKeys = tronWeb.fromMnemonic(seedPhrase);
      const tronAddress = tronWeb.address.fromPrivateKey(tronKeys.privateKey);

      document.getElementById('results').innerHTML = `
        <p><strong>BTC Address:</strong> ${address}</p>
        <p><strong>ETH Address:</strong> ${ethAddress}</p>
        <p><strong>TRON Address:</strong> ${tronAddress}</p>
      `;
    }
  </script>
</body>
</html>
